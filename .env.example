# Environment Variables: (.env)
# --- Flask Server Port ---
FLASK_HOST=0.0.0.0
FLASK_RUN_PORT=5050

FLASK_CONFIG=development

# --- Application Security ---
SECRET_KEY=your_secret_key_here

# --- PostgreSQL Connection ---
# Matches the default Docker Compose PostgreSQL credentials for local development.
DATABASE_URI=postgresql://tushar:password@localhost:5432/cognilit_ai

# --- Redis Cache (M1) ---
REDIS_URL=redis://localhost:6379/0

# --- Gemini API (M3) ---
# CRITICAL: Replace with your actual Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=your_gemini_model_here

# --- GROQ API Key ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_groq_model_here

# --- Email Service: Titan Mail (SMTP_SSL) ---
MAIL_SERVER='smtpout.secureserver.net'
MAIL_PORT=465
MAIL_USERNAME='your_email_here'
MAIL_PASSWORD='your_email_password_here'
MAIL_FROM='your_email_here'
MAIL_FROM_NAME='CogniLit AI'
MAIL_ADMIN_ADDRESS='your_admin_email_here'